# ---- Instagram / Meta credentials -------------------------------------------
# Long-lived User Access Token (60 days). Can also be entered in the dashboard,
# which takes precedence over this value.
INSTAGRAM_ACCESS_TOKEN=
# Instagram Business/Creator account ID (17841...). Also settable in the dashboard.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Facebook Page linked to the Instagram account. Needed to send DMs. Also settable in the dashboard.
FACEBOOK_PAGE_ID=

# App Secret (App settings > Basic). Used to validate X-Hub-Signature-256 on every webhook.
FACEBOOK_APP_SECRET=
# App ID (App settings > Basic). Optional: enables the "Refresh token" button.
FACEBOOK_APP_ID=
# Any random string you choose; paste the same value into the Meta webhook "Verify token" field.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_VERIFY_TOKEN=

# ---- App ----------------------------------------------------------------------
DATABASE_URL=sqlite:///./app.db
# Protects /dashboard and /api with HTTP Basic auth. STRONGLY recommended in production.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Graph API version to call.
GRAPH_API_VERSION=v23.0
LOG_LEVEL=INFO
